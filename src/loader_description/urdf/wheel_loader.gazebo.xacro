<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:if value="${sim == 'classic'}">
    <gazebo reference="wheel_01_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_02_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_03_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_04_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor type="camera" name="rgb_camera">
        <update_rate>30</update_rate><always_on>true</always_on><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100.0</far></clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>camera</namespace></ros>
          <camera_name>rgb</camera_name>
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor type="ray" name="lidar_2d">
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle></horizontal></scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="lidar_2d_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/lidar</namespace><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    
    <xacro:if value="${lidar_3d}">
    <gazebo reference="lidar_link">
      <sensor type="ray" name="lidar_3d">
        <always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.087266</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>25.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </ray>
        <plugin name="lidar_3d_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/lidar</namespace><remapping>~/out:=points</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    </xacro:if>
    
    <gazebo reference="imu_link">
      <sensor type="imu" name="imu_sensor">
        <always_on>true</always_on><visualize>false</visualize><update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><namespace>/imu</namespace><remapping>~/out:=data</remapping></ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    
    <xacro:if value="${rear_camera}">
      <gazebo reference="rear_camera_link">
        <sensor type="camera" name="rear_camera">
          <update_rate>15</update_rate><always_on>true</always_on><visualize>false</visualize>
          <camera><horizontal_fov>1.8</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15.0</far></clip></camera>
          <plugin name="rear_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros><namespace>camera</namespace></ros><camera_name>rear</camera_name><frame_name>rear_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:if>
  
  <xacro:if value="${sim == 'ignition'}">
    <gazebo reference="wheel_01_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_02_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_03_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_04_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>
    <gazebo reference="camera_link">
      <sensor type="rgbd_camera" name="rgbd_camera">
        <update_rate>30</update_rate><always_on>true</always_on><topic>camera</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.2</near><far>8.0</far></clip></camera>
        <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
