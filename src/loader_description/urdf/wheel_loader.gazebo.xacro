<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- friction / contact (tuning values, not measured) -->
  <xacro:if value="${sim == 'classic'}">
    <gazebo reference="wheel_01_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_02_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_03_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo reference="wheel_04_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>
    <gazebo reference="camera_link">
      <sensor type="depth" name="rgbd_camera">
        <update_rate>30</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.2</near><far>8.0</far></clip></camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>
  <xacro:if value="${sim == 'ignition'}">
    <gazebo reference="wheel_01_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_02_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_03_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="wheel_04_link"><collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>
    <gazebo reference="camera_link">
      <sensor type="rgbd_camera" name="rgbd_camera">
        <update_rate>30</update_rate><always_on>true</always_on><topic>camera</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.2</near><far>8.0</far></clip></camera>
        <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
