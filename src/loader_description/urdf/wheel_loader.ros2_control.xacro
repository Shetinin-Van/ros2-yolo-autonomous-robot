<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:if value="${sim != 'none'}">
  <ros2_control name="WheelLoaderSystem" type="system">
    <hardware>
      <xacro:if value="${sim == 'mock'}"><plugin>mock_components/GenericSystem</plugin></xacro:if>
      <xacro:if value="${sim == 'classic'}"><plugin>gazebo_ros2_control/GazeboSystem</plugin></xacro:if>
      <xacro:if value="${sim == 'ignition'}"><plugin>ign_ros2_control/IgnitionSystem</plugin></xacro:if>
    </hardware>
    <!-- 4 independent wheel drives (velocity) -->
    <joint name="wheel_01_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wheel_02_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wheel_03_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wheel_04_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <!-- articulation (hydraulic steering, modelled as position-controlled joint) -->
    <joint name="front_frame_joint"><command_interface name="position"><param name="min">-0.610865</param><param name="max">0.610865</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_lift_arm_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_lift_arm_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="bucket_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  </xacro:if>
</robot>
