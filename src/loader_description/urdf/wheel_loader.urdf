  <link name="camera_optical_frame"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.196892" rpy="0 0 0"/>
  </joint>
  <joint name="front_frame_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_frame"/>
    <origin xyz="0.576 0 0.093722" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.610865" upper="0.610865" effort="40000" velocity="0.35"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="wheel_01_joint" type="continuous">
    <parent link="front_frame"/>
    <child link="wheel_01_link"/>
    <origin xyz="0.5428 0.572864 -0.093722" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="600" velocity="12"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="wheel_02_joint" type="continuous">
    <parent link="front_frame"/>
    <child link="wheel_02_link"/>
    <origin xyz="0.5428 -0.572864 -0.093722" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="600" velocity="12"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="wheel_03_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_03_link"/>
    <origin xyz="0 0.726464 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="600" velocity="12"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="wheel_04_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_04_link"/>
    <origin xyz="0 -0.726464 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="600" velocity="12"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <joint name="bucket_joint" type="revolute">
