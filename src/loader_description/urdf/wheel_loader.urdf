  <link name="wheel_04_link">
    <inertial>
      <origin xyz="0 0.007485 0" rpy="0 0 0"/>
      <mass value="45"/>
      <inertia ixx="0.506903" ixy="0" ixz="-0" iyy="0.83405" iyz="0" izz="0.506903"/>
