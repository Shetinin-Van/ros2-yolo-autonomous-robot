<?xml version="1.0"?>
<!-- wheel_loader.urdf.xacro  -  articulated front-end wheel loader (ROS 2 Humble).
     Frames: ROS convention (x forward, y left, z up). base_link = rear axle centre at axle height,
     base_footprint = its projection on the ground. All lengths in metres, STL files in link frames.
     Joint/inertia numbers are generated from the corrected STEP assembly (see docs/ANALYSIS.md). -->
<robot name="wheel_loader" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sim" default="none"/>              <!-- none | mock | classic | ignition -->
  <xacro:arg name="add_axle_stubs" default="true"/>
  <xacro:arg name="controllers_yaml" default="$(find loader_description)/config/ros2_controllers.yaml"/>
  <xacro:property name="sim" value="$(arg sim)"/>
  <xacro:property name="add_axle_stubs" value="$(arg add_axle_stubs)"/>
  <xacro:property name="controllers_yaml" value="$(arg controllers_yaml)"/>
  <xacro:property name="wheel_radius" value="0.196892"/>
  <xacro:property name="wheel_width" value="0.169728"/>
  <xacro:property name="stub_radius" value="0.032"/>
  <xacro:property name="front_limit" value="0.610865"/>
  <xacro:property name="front_effort" value="40000"/>
  <xacro:property name="front_velocity" value="0.35"/>
  <xacro:property name="arm_lower" value="-0.2135"/>
  <xacro:property name="arm_upper" value="0.7854"/>
  <xacro:property name="arm_effort" value="40000"/>
  <xacro:property name="arm_velocity" value="0.4"/>
  <xacro:property name="bucket_lower" value="-0.8727"/>
  <xacro:property name="bucket_upper" value="0.6"/>
  <xacro:property name="bucket_effort" value="25000"/>
  <xacro:property name="bucket_velocity" value="0.6"/>
  <xacro:property name="wheel_effort" value="600"/>
  <xacro:property name="wheel_velocity" value="12"/>

  <material name="frame_green"><color rgba="0.43 0.5 0.43 1"/></material>
  <material name="cab_green"><color rgba="0.39 0.45 0.41 1"/></material>
  <material name="glass"><color rgba="0.5 0.72 0.82 0.35"/></material>
  <material name="steel"><color rgba="0.36 0.38 0.4 1"/></material>
  <material name="tire_black"><color rgba="0.09 0.1 0.11 1"/></material>
  <material name="lug_grey"><color rgba="0.2 0.21 0.22 1"/></material>
  <material name="arm_dark"><color rgba="0.21 0.23 0.25 1"/></material>
  <material name="fender_black"><color rgba="0.12 0.14 0.15 1"/></material>
  <material name="camera_dark"><color rgba="0.04 0.04 0.05 1"/></material>

  <xacro:macro name="wheel" params="id parent side xyz">
    <link name="${id}_link">
      <inertial>
        <origin xyz="0 -0.007485 0" rpy="0 0 0"/>
        <mass value="45"/>
        <inertia ixx="0.506902" ixy="0" ixz="-0" iyy="0.834048" iyz="0" izz="0.506902"/>
      </inertial>
      <visual name="tire">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://loader_description/meshes/visual/wheel_${side}_tire.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="tire_black"/>
      </visual>
      <visual name="lugs">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://loader_description/meshes/visual/wheel_${side}_lugs.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="lug_grey"/>
      </visual>
      <collision name="tire">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${id}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${id}_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
      <dynamics damping="1.0" friction="0.5"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.259163 0.000379 0.396715" rpy="0 0 0"/>
      <mass value="733.3"/>
      <inertia ixx="181.713235" ixy="-0.033091" ixz="-17.15344" iyy="205.897792" iyz="-0.197838" izz="196.657879"/>
    </inertial>
    <visual name="rear_frame">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://loader_description/meshes/visual/rear_frame.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_green"/>
    </visual>
    <visual name="cab_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/cab_body.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cab_green"/>
    </visual>
    <visual name="cab_glass">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/cab_glass.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="glass"/>
    </visual>
    <visual name="cab_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/cab_base.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="rear_hinge_lugs">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/rear_hinge_lugs.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="frame_green"/>
    </visual>
    <visual name="hinge_pin">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/hinge_pin.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="rear_stub_pin_right">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/rear_stub_pin_right.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="rear_stub_pin_left">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/rear_stub_pin_left.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="fender_rr">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/fender_rr.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="fender_black"/>
    </visual>
    <visual name="fender_rl">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/fender_rl.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="fender_black"/>
    </visual>
    <collision name="rear_frame_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/rear_frame_collision.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="cab_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/cab_collision.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <xacro:if value="${add_axle_stubs}">
      <visual name="axle_stub_0">
        <origin xyz="0 0.686032 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${stub_radius}" length="0.104864"/></geometry>
        <material name="steel"/>
      </visual>
      <visual name="axle_stub_1">
        <origin xyz="0 -0.686032 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${stub_radius}" length="0.104864"/></geometry>
        <material name="steel"/>
      </visual>
    </xacro:if>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.196892" rpy="0 0 0"/>
  </joint>
  <link name="front_frame">
    <inertial>
      <origin xyz="0.610379 -0 0.087466" rpy="0 0 0"/>
      <mass value="391"/>
      <inertia ixx="45.484696" ixy="0.000001" ixz="-1.902399" iyy="40.977378" iyz="0" izz="56.523577"/>
    </inertial>
    <visual name="front_frame">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/front_frame.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="frame_green"/>
    </visual>
    <visual name="front_plate">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/front_plate.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="front_hinge_lugs">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/front_hinge_lugs.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="frame_green"/>
    </visual>
    <visual name="hinge_bushing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/hinge_bushing.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="fender_fr">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/fender_fr.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="fender_black"/>
    </visual>
    <visual name="fender_fl">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/fender_fl.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="fender_black"/>
    </visual>
    <collision name="front_frame_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/front_frame_collision.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <xacro:if value="${add_axle_stubs}">
      <visual name="axle_stub_0">
        <origin xyz="0.5568 0.609232 -0.093722" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${stub_radius}" length="0.258464"/></geometry>
        <material name="steel"/>
      </visual>
      <visual name="axle_stub_1">
        <origin xyz="0.5568 -0.609232 -0.093722" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${stub_radius}" length="0.258464"/></geometry>
        <material name="steel"/>
      </visual>
    </xacro:if>
  </link>
  <joint name="front_frame_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_frame"/>
    <origin xyz="0.576 0 0.093722" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-front_limit}" upper="${front_limit}" effort="${front_effort}" velocity="${front_velocity}"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <xacro:wheel id="wheel_01" parent="front_frame" side="left" xyz="0.5568 0.738464 -0.093722"/>
  <xacro:wheel id="wheel_02" parent="front_frame" side="right" xyz="0.5568 -0.738464 -0.093722"/>
  <xacro:wheel id="wheel_03" parent="base_link" side="left" xyz="0 0.738464 0"/>
  <xacro:wheel id="wheel_04" parent="base_link" side="right" xyz="0 -0.738464 0"/>
  <link name="left_lift_arm_link">
    <inertial>
      <origin xyz="0.614868 0 -0.063575" rpy="0 0 0"/>
      <mass value="40"/>
      <inertia ixx="0.535975" ixy="0" ixz="1.260558" iyy="5.541487" iyz="0" izz="5.037363"/>
    </inertial>
    <visual name="left_lift_arm">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/left_lift_arm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_dark"/>
    </visual>
    <collision name="col0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/lift_arm_left_col0.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="col1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/lift_arm_left_col1.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="left_lift_arm_joint" type="revolute">
    <parent link="front_frame"/>
    <child link="left_lift_arm_link"/>
    <origin xyz="0.53332 0.51456 0.331346" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lower}" upper="${arm_upper}" effort="${arm_effort}" velocity="${arm_velocity}"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="right_lift_arm_link">
    <inertial>
      <origin xyz="0.614868 0 -0.063575" rpy="0 0 0"/>
      <mass value="40"/>
      <inertia ixx="0.535975" ixy="0" ixz="1.260558" iyy="5.541487" iyz="0" izz="5.037363"/>
    </inertial>
    <visual name="right_lift_arm">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/right_lift_arm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_dark"/>
    </visual>
    <collision name="col0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/lift_arm_right_col0.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="col1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/lift_arm_right_col1.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="right_lift_arm_joint" type="revolute">
    <parent link="front_frame"/>
    <child link="right_lift_arm_link"/>
    <origin xyz="0.53332 -0.51456 0.331346" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lower}" upper="${arm_upper}" effort="${arm_effort}" velocity="${arm_velocity}"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="bucket_link">
    <inertial>
      <origin xyz="0.09217 0.000392 0.012497" rpy="0 0 0"/>
      <mass value="90"/>
      <inertia ixx="17.02126" ixy="-0.005326" ixz="0.173934" iyy="0.970406" iyz="-0.000214" izz="17.235275"/>
    </inertial>
    <visual name="bucket">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/bucket.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_dark"/>
    </visual>
    <collision name="floor">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/bucket_floor.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="back_wall">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/bucket_back_wall.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="side_left">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/bucket_side_left.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <collision name="side_right">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/collision/bucket_side_right.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="bucket_joint" type="revolute">
    <parent link="left_lift_arm_link"/>
    <child link="bucket_link"/>
    <origin xyz="1.223675 -0.51456 -0.264192" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${bucket_lower}" upper="${bucket_upper}" effort="${bucket_effort}" velocity="${bucket_velocity}"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.075462 0 0.000464" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00116" ixy="0" ixz="-0.000013" iyy="0.000845" iyz="0" izz="0.001404"/>
    </inertial>
    <visual name="camera_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/camera_body.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="camera_dark"/>
    </visual>
    <visual name="camera_rear_ports">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://loader_description/meshes/visual/camera_rear_ports.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="camera_dark"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15118 0 1.256902" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- <xacro:include filename="$(find loader_description)/urdf/wheel_loader.ros2_control.xacro"/> -->
  <!-- <xacro:include filename="$(find loader_description)/urdf/wheel_loader.gazebo.xacro"/> -->
</robot>
