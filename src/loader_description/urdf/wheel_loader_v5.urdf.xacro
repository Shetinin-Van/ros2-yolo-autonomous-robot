<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_loader_v5">
  
  <material name="body"><color rgba="0.53 0.57 0.52 1"/></material>
  <material name="tire"><color rgba="0.14 0.16 0.17 1"/></material>
  <material name="hub"><color rgba="0.41 0.45 0.46 1"/></material>
  <material name="steel"><color rgba="0.54 0.57 0.58 1"/></material>
  <material name="boom"><color rgba="0.33 0.37 0.38 1"/></material>
  <material name="bucket"><color rgba="0.27 0.30 0.32 1"/></material>
  <material name="glass"><color rgba="0.20 0.27 0.29 0.82"/></material>
  <material name="cab"><color rgba="0.46 0.50 0.46 1"/></material>
  <material name="camera"><color rgba="0.20 0.23 0.24 1"/></material>

  <link name="base_link">
    <inertial>
      <mass value="1500.0"/>
      <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/rear_frame_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="body"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/rear_frame_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>

  <link name="front_frame">
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="50" ixy="0" ixz="0" iyy="50" iyz="0" izz="50"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/front_frame_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="body"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/front_frame_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>

  <joint name="articulation_joint" type="revolute">
    <parent link="base_link"/><child link="front_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.610865" upper="0.610865" effort="25000" velocity="0.5"/>
    <dynamics damping="120" friction="20"/>
  </joint>

  <link name="wheel_01">
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_01_tire_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="tire"/></visual>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_01_hub_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="hub"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_01_tire_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="wheel_01_joint" type="continuous">
    <parent link="front_frame"/><child link="wheel_01"/>
    <origin xyz="-1.3000 -1.4500 -0.0030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit effort="4500" velocity="18"/><dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="wheel_02">
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_02_tire_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="tire"/></visual>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_02_hub_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="hub"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_02_tire_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="wheel_02_joint" type="continuous">
    <parent link="front_frame"/><child link="wheel_02"/>
    <origin xyz="1.3000 -1.4500 -0.0030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit effort="4500" velocity="18"/><dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="wheel_03">
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_03_tire_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="tire"/></visual>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_03_hub_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="hub"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_03_tire_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="wheel_03_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_03"/>
    <origin xyz="-1.3000 1.5000 -0.0030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit effort="4500" velocity="18"/><dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="wheel_04">
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_04_tire_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="tire"/></visual>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_04_hub_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="hub"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/wheel_04_tire_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="wheel_04_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_04"/>
    <origin xyz="1.3000 1.5000 -0.0030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit effort="4500" velocity="18"/><dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="lift_arms">
    <inertial>
      <mass value="300.0"/>
      <inertia ixx="30" ixy="0" ixz="0" iyy="30" iyz="0" izz="30"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/lift_arms_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="boom"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/lift_arms_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="lift_joint" type="revolute">
    <parent link="front_frame"/><child link="lift_arms"/>
    <origin xyz="0 -0.95 0.26" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.15" upper="0.85" effort="30000" velocity="0.6"/><dynamics damping="100" friction="10"/>
  </joint>

  <link name="bucket">
    <inertial>
      <mass value="400.0"/>
      <inertia ixx="40" ixy="0" ixz="0" iyy="40" iyz="0" izz="40"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/bucket_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="bucket"/></visual>
    <collision><geometry><mesh filename="package://loader_description/meshes/urdf_local/bucket_link.stl" scale="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="bucket_tilt_joint" type="revolute">
    <parent link="lift_arms"/><child link="bucket"/>
    <origin xyz="0 -1.40 -0.53" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.75" upper="0.75" effort="18000" velocity="0.8"/><dynamics damping="80" friction="8"/>
  </joint>

  <link name="hydraulics">
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/hydraulics_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="hydraulics_fixed" type="fixed"><parent link="front_frame"/><child link="hydraulics"/><origin xyz="0 0 0"/></joint>

  <link name="cab_frame">
    <inertial>
      <mass value="200.0"/>
      <inertia ixx="20" ixy="0" ixz="0" iyy="20" iyz="0" izz="20"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/cab_frame_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="cab"/></visual>
  </link>
  <joint name="cab_frame_fixed" type="fixed"><parent link="base_link"/><child link="cab_frame"/><origin xyz="0 0 0"/></joint>

  <link name="cab_glass">
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="2" ixy="0" ixz="0" iyy="2" iyz="0" izz="2"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/cab_glass_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="glass"/></visual>
  </link>
  <joint name="cab_glass_fixed" type="fixed"><parent link="base_link"/><child link="cab_glass"/><origin xyz="0 0 0"/></joint>

  <link name="rgbd_camera">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/rgbd_camera_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="camera"/></visual>
  </link>
  <joint name="rgbd_camera_fixed" type="fixed"><parent link="base_link"/><child link="rgbd_camera"/><origin xyz="0 1.84 2.12"/></joint>

  <link name="rear_lights">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/rear_lights_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="rear_lights_fixed" type="fixed"><parent link="base_link"/><child link="rear_lights"/><origin xyz="0 0 0"/></joint>

  <link name="front_lights">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/front_lights_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="front_lights_fixed" type="fixed"><parent link="front_frame"/><child link="front_lights"/><origin xyz="0 0 0"/></joint>

  <link name="articulation_rear">
    <inertial><mass value="50.0"/><inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/></inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/articulation_rear_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="articulation_rear_fixed" type="fixed"><parent link="base_link"/><child link="articulation_rear"/><origin xyz="0 0 0"/></joint>

  <link name="articulation_front">
    <inertial><mass value="50.0"/><inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/></inertial>
    <visual><geometry><mesh filename="package://loader_description/meshes/urdf_local/articulation_front_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
  </link>
  <joint name="articulation_front_fixed" type="fixed"><parent link="front_frame"/><child link="articulation_front"/><origin xyz="0 0 0"/></joint>

  <link name="camera_optical_frame">
    <inertial><mass value="0.001"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed"><parent link="rgbd_camera"/><child link="camera_optical_frame"/><origin xyz="0 -0.10 0" rpy="1.5708 0 0"/></joint>

</robot>
