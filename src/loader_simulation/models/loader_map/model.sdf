<?xml version="1.0"?>
<sdf version="1.6">
  <model name="loader_map">
    <static>true</static>

    <link name="map_link">
      <visual name="map_visual">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>160 120</size>
          </plane>
        </geometry>

        <material>
          <script>
            <uri>model://loader_map/materials/scripts</uri>
            <uri>model://loader_map/materials/textures</uri>
            <name>LoaderMap/Track</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>

