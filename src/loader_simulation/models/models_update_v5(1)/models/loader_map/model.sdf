<?xml version="1.0"?>
<sdf version="1.6">
  <model name="loader_map">
    <static>true</static>

    <link name="map_link">
      <collision name="map_collision">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>160 120 0.1</size></box></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
      </collision>
      <visual name="map_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <cast_shadows>false</cast_shadows>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>160 120</size>
          </plane>
        </geometry>

        <material>
          <script>
            <uri>model://loader_map/materials/scripts</uri>
            <uri>model://loader_map/materials/textures</uri>
            <name>LoaderMap/Track</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>

